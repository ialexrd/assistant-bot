# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Ваш Telegram id (бот покажет его по /id). Только эти люди управляют ботом.
OWNER_IDS=111111111
# Мастер, которому вечером уходит сводка заказов на завтра
MASTER_CHAT_ID=
TZ=Europe/Kaliningrad
MORNING_TIME=09:00
MASTER_SUMMARY_TIME=20:00

# ===== ВКонтакте (можно оставить пустым) =====
# Ключ доступа сообщества с правами «Управление сообществом» и «Сообщения сообщества» и id сообщества (число без минуса)
VK_GROUP_TOKEN=
VK_GROUP_ID=

# ===== ИИ: deepseek | anthropic =====
LLM_PROVIDER=deepseek
# Ключ: platform.deepseek.com → API keys (пополнить баланс там же)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Claude, если когда-нибудь захотите вернуться: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ===== Голосовые в текст: yandex | openai | off =====
STT_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
OPENAI_API_KEY=
# Расшифровывать голосовые клиентов, чтобы ИИ учитывал их при оформлении заказа (1 или 0)
TRANSCRIBE_CLIENT_VOICE=1

# ===== Копия заявок на Яндекс Почту (можно оставить пустым) =====
# Куда слать письма
MAIL_TO=you@yandex.ru
# От чьего имени: ваш ящик Яндекса и пароль приложения
# (id.yandex.ru → Безопасность → Пароли приложений → Почта). Обычный пароль не подойдёт.
SMTP_USER=you@yandex.ru
SMTP_PASSWORD=

# ===== Firebase и Google Таблица =====
# Ключ сервисного аккаунта проекта crm-orders-a794f
GOOGLE_APPLICATION_CREDENTIALS=/opt/assistant-bot/firebase-key.json
# Копия новых заказов в Google Таблицу, как делает сайт CRM
SHEETS_URL=https://script.google.com/macros/s/AKfycbx9yN5t8yVkiXFpC1hgjk7TIzfH0aMLA1IWsHpJAUnBiPnYX3YcyPdzKpYZGFYPgeGOXQ/exec
